  "keyFeatures": [
    "Full CRUD for product catalog with image and variant management",
    "Product variants with size (talle) and color combinations and per-variant stock tracking",
    "Logical activation/deactivation of products (soft delete)",
    "Image upload and deletion via Multer with disk storage",
    "Public read-only store endpoints with censored stock information",
    "Admin panel served as static HTML with real-time catalog management",
    "PostgreSQL (Supabase) connection via connection pool with SSL",
    "Database view (vista_catalogo_productos) aggregating product, image, and variant data",
    "Transactional product creation and updates with ROLLBACK on error",
    "Vercel deployment support"
  ],
  "publicApiSurface": [
    "GET /api/v1/admin/productos",
    "GET /api/v1/admin/productos/:id",
    "POST /api/v1/admin/productos",
    "PUT /api/v1/admin/productos/:id",
    "PATCH /api/v1/admin/productos/:id/activar",
    "PATCH /api/v1/admin/productos/:id/desactivar",
    "DELETE /api/v1/admin/productos/:id",
    "POST /api/v1/admin/imagenes/subir",
    "DELETE /api/v1/admin/imagenes/:id",
    "GET /api/v1/admin/categorias",
    "GET /api/v1/admin/talles",
    "GET /api/v1/admin/colores",
    "GET /api/v1/tienda/productos",
    "GET /api/v1/tienda/productos/:id"
  ]
